{
  "name": "chrono-desktop",
  "productName": "时序 Chrono",
  "version": "1.5.2",
  "description": "时序 Chrono — 个人时间调度(桌面版)",
  "main": "main.js",
  "author": "Walter Vance Wang",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.chrono.desktop",
    "productName": "时序 Chrono",
    "copyright": "AGPL-3.0-or-later",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "时序 Chrono",
      "language": "2052",
      "artifactName": "Chrono-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Chrono-Portable-${version}.exe"
    }
  }
}
