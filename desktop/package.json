{
  "name": "chrono-desktop",
  "productName": "时序 Chrono",
  "version": "1.5.5",
  "description": "时序 Chrono — 个人时间调度(桌面版)",
  "main": "main.js",
  "author": {
    "name": "Chrono contributors",
    "email": "chrono@users.noreply.github.com"
  },
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist": "node prepare.js && electron-builder --win --publish never",
    "dist:mac": "node prepare.js && electron-builder --mac --publish never",
    "dist:linux": "node prepare.js && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.chrono.desktop",
    "productName": "时序 Chrono",
    "copyright": "AGPL-3.0-or-later",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "时序 Chrono",
      "language": "2052",
      "artifactName": "Chrono-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Chrono-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "artifactName": "Chrono-${version}-${arch}.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Chrono contributors <chrono@users.noreply.github.com>",
      "artifactName": "Chrono-${version}.${ext}"
    }
  },
  "homepage": "https://github.com/zhanguochunqiu666/Chrono"
}
